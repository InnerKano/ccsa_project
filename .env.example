# Copy to .env and adjust for local development:
#   cp .env.example .env

# --- Backend ---
# Host value (venv, alembic, pytest against a real DB). `localhost:5432` reaches
# the Postgres container's published port. Under Docker Compose this line is
# ignored: docker-compose.yml overrides DATABASE_URL to use the `db` hostname on
# the Compose network. Keep this as localhost so the venv workflow works as-is
# (see workflows/local-dev.md).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ccsa
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-in-production
JWT_EXPIRE_MINUTES=10080
# Password reset link lifetime in minutes (D23). Keep short.
PASSWORD_RESET_EXPIRE_MINUTES=15

# Set true only for venv/pytest without a running Postgres (Step 2.1 style)
SKIP_DB_CHECK=false

# Comma-separated CORS allow-list (browser origins that may call the API).
# Never "*" in production — add the deployed frontend origin here.
CORS_ORIGINS=http://localhost:3000

# Public frontend base URL — used to build password-reset links
# (${FRONTEND_URL}/reset-password?token=...). Set to the deployed origin in prod.
FRONTEND_URL=http://localhost:3000

# --- Email (password recovery, D23) ---
# EMAIL_ENABLED=false → dev fallback that only LOGS the reset link to the backend
#   console (never sends). Use this to test recovery locally without SMTP.
#   Must be true in production so links are actually delivered.
# Gmail requires an App Password (Google Account → Security), NOT the account
# password. EMAIL_FROM defaults to SMTP_USER when left blank.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Database (Compose service `db`) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ccsa
