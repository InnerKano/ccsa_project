# Copy to .env and adjust for local development:
#   cp .env.example .env

# --- Backend ---
DATABASE_URL=postgresql://postgres:postgres@db:5432/ccsa
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-in-production
JWT_EXPIRE_MINUTES=10080

# Set true only for venv/pytest without a running Postgres (Step 2.1 style)
SKIP_DB_CHECK=false

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Database (Compose service `db`) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ccsa
